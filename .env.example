# Google Gemini API key for the Gemini 2.5 Flash with Thinking Mode integration.
# Used by the Supabase Edge Function `score-candidate` to parse and score resumes.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase project URL (https://<ref>.supabase.co) and anon key.
# Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. Server-side only. Required for the instrumentation
# hook below to provision the recruiter account on server start.
SUPABASE_SERVICE_ROLE_KEY=

# Recruiter credentials. The Next.js instrumentation hook idempotently creates
# (or resets the password of) this user on every server start. This is the ONLY
# account that can sign in — the homepage has no public signup.
RECRUITER_EMAIL=
RECRUITER_PASSWORD=

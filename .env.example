# Google Gemini API key for the Gemini 2.5 Flash with Thinking Mode integration.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase project URL (https://<ref>.supabase.co) and anon key.
# Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. Server-side only. Never import this in a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=
